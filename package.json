{
  "name": "@aihu/editor",
  "version": "0.1.2",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./safe-href": {
      "types": "./dist/safe-href.d.ts",
      "import": "./dist/safe-href.js"
    },
    "./components/aihu-editor.aihu": "./components/aihu-editor.aihu",
    "./components/aihu-editor-toolbar.aihu": "./components/aihu-editor-toolbar.aihu"
  },
  "files": [
    "dist",
    "components",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --environment jsdom",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "check:lint": "biome ci .",
    "check:ci": "bun run check:lint && bun run typecheck && bun run test && bun run build && bun run pack:check",
    "pack:check": "bun scripts/check-pack.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aihu/signals": "^0.5.1"
  },
  "devDependencies": {
    "@aihu/compiler": "^1.3.6",
    "@biomejs/biome": "2.4.14",
    "@playwright/test": "1.59.1",
    "@types/node": "^20.16.5",
    "fast-check": "^3.22.0",
    "jsdom": "^25.0.1",
    "rolldown": "^1.0.0-rc.17",
    "rolldown-plugin-dts": "^0.23.2",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  },
  "description": "Hand-rolled, dependency-free, GX-governed rich-text editor \u2014 JSON doc model, invertible transactions, markdown (web-v1 dialect) round-trip, contenteditable view with IME-safe read-back, agent read/suggest/write surface.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aihu-project/aihu-editor.git"
  },
  "homepage": "https://github.com/aihu-project/aihu-editor#readme",
  "bugs": "https://github.com/aihu-project/aihu-editor/issues",
  "publishConfig": {
    "access": "public"
  }
}
